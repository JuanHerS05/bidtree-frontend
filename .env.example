# ───────────── Modo de datos ─────────────
# true  = datos simulados en memoria (no necesita backend). false = backend real.
VITE_USE_MOCKS=true

# ───────────── Conexión a microservicios ─────────────
# Opción A (recomendada): todo pasa por UN gateway/Eureka.
VITE_GATEWAY_URL=http://localhost:8080

# Opción B: URL directa por servicio (si se define, tiene prioridad sobre el gateway).
# VITE_URL_USUARIOS=http://localhost:8081
# VITE_URL_SUBASTAS=http://localhost:8082
# VITE_URL_PUJAS=http://localhost:8083
# VITE_URL_PAGOS_ALERTAS=http://localhost:8084

# Prefijo de ruta por servicio (útil con Spring Cloud Gateway + Eureka: /MS-USUARIOS, etc.)
# VITE_PREFIX_USUARIOS=/ms-usuarios
# VITE_PREFIX_SUBASTAS=/ms-subastas
# VITE_PREFIX_PUJAS=/ms-pujas
# VITE_PREFIX_PAGOS_ALERTAS=/ms-pagos-alertas

# Base WebSocket por servicio (por defecto se deriva de la URL HTTP: http→ws, https→wss)
# VITE_WS_PUJAS=ws://localhost:8083
# VITE_WS_PAGOS_ALERTAS=ws://localhost:8084

# ───────────── Nombres de tópicos Kafka ─────────────
# Solo se definen si quieres renombrarlos (los valores por defecto vienen del documento).
# VITE_TOPIC_USER_CREATED=user-created-topic
# VITE_TOPIC_AUCTION_ENDED=auction-ended
# VITE_TOPIC_PAYMENT_REGISTERED=payment-registered-topic
# VITE_TOPIC_OUTBID=outbid-topic
# VITE_TOPIC_PRICE_LIMIT=price-limit-reached-topic
# VITE_TOPIC_PAYMENT_REASSIGNMENT=payment-reassignment-topic
